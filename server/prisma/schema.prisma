generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./studio.db"
}

model Student {
  id         String    @id @default(cuid())
  identifier String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id           String    @id @default(cuid())
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    String
  boardType    String?
  sketchName   String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMs   Int?
  endReason    String?
  simStarted   Boolean   @default(false)
  simCompleted Boolean   @default(false)
  events       Event[]

  @@index([studentId])
  @@index([startedAt])
}

model Event {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  type      String
  payload   String?
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
